# Database Configuration (Supabase)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_password
SUPABASE_DB_STRING=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
SUPABASE_POOLER_STRING=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
USE_SUPABASE_POOLER=true

# Azure OpenAI Configuration
LLM_PROVIDER=azure_openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60
LLM_AZURE_OPENAI_API_KEY=your_azure_api_key
LLM_AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
LLM_AZURE_DEPLOYMENT_NAME=gpt-4o
LLM_AZURE_API_VERSION=2024-02-15-preview
LLM_AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Incident Management
INCIDENT_MAX_SOLUTION_ATTEMPTS=3
INCIDENT_SESSION_TIMEOUT_MINUTES=30
INCIDENT_CLEANUP_INTERVAL_HOURS=24
INCIDENT_RETENTION_DAYS=30

# Public URL (set to your Render URL)
PUBLIC_URL=https://your-app.onrender.com

# Chainlit Authentication
CHAINLIT_AUTH_SECRET=your_secret_key_here

# PDF Server Configuration (optional)
PDF_SERVER_PORT=8080